---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="ms-MY">
  <title>Blog Zul Air Cond &amp; Electrical: Servis &amp; Baiki Aircond Kelantan</title>
  <subtitle>Tips servis aircond Kelantan, baiki aircond dan kerja elektrik di seluruh Kelantan &amp; Besut.</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/blog/" rel="alternate" type="text/html"/>
  <id>{{ site.url }}/blog/</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>Zul Air Cond &amp; Electrical</name><uri>{{ site.url }}/</uri></author>
  <icon>{{ site.url }}/icon-192.png</icon>
{%- for post in site.posts limit:20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
    <category term="{{ post.kategori | xml_escape }}"/>
  </entry>
{%- endfor %}
</feed>
